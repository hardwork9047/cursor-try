{
  "name": "demo-js-wasm-bench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite --port 5175",
    "typecheck": "tsc --noEmit",
